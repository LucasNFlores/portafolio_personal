---
interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  images?: string[];
  liveUrl?: string;
  repoUrl?: string;
  clickable?: boolean;
  dataIndex?: number;
  hideImage?: boolean;
}

const { title, description, tags, image, images, liveUrl, repoUrl, clickable, dataIndex, hideImage } = Astro.props;

// Use images[0] as cover if available, otherwise fallback to image prop
const coverImage = images && images.length > 0 ? images[0] : image;
---

{clickable ? (
  <button
    type="button"
    class="project-card-btn"
    data-index={dataIndex}
    aria-label={`Ver detalles de ${title}`}
    aria-haspopup="dialog"
  >
    <article class="project-card card">
      {!hideImage && (
        <div class="project-card__img-wrap">
          {coverImage ? (
            <img
              src={coverImage}
              alt={`Captura de pantalla de ${title}`}
              class="project-card__img"
              loading="lazy"
              width="400"
              height="220"
            />
          ) : (
            <div class="project-card__img-placeholder" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
              </svg>
            </div>
          )}
          <div class="project-card__overlay" aria-hidden="true"></div>
        </div>
      )}
      <div class="project-card__body">
        <h3 class="project-card__title">{title}</h3>
        <p class="project-card__desc">{description}</p>
        <div class="project-card__tags" role="list" aria-label="Tecnologías usadas">
          {tags.map(tag => (
            <span class="tag" role="listitem">{tag}</span>
          ))}
        </div>
        <div class="project-card__links">
          {liveUrl && (
            <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="project-card__link" aria-label={`Ver demo de ${title}`}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Demo
            </a>
          )}
          {repoUrl && (
            <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="project-card__link" aria-label={`Ver repositorio de ${title}`}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              Código
            </a>
          )}
        </div>
      </div>
    </article>
  </button>
) : (
  <article class="project-card card">
    {!hideImage && (
      <div class="project-card__img-wrap">
        {coverImage ? (
          <img
            src={coverImage}
            alt={`Captura de pantalla de ${title}`}
            class="project-card__img"
            loading="lazy"
            width="400"
            height="220"
          />
        ) : (
          <div class="project-card__img-placeholder" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
              <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
            </svg>
          </div>
        )}
        <div class="project-card__overlay" aria-hidden="true"></div>
      </div>
    )}
    <div class="project-card__body">
      <h3 class="project-card__title">{title}</h3>
      <p class="project-card__desc">{description}</p>
      <div class="project-card__tags" role="list" aria-label="Tecnologías usadas">
        {tags.map(tag => (
          <span class="tag" role="listitem">{tag}</span>
        ))}
      </div>
      <div class="project-card__links">
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="project-card__link" aria-label={`Ver demo de ${title}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Demo
          </a>
        )}
        {repoUrl && (
          <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="project-card__link" aria-label={`Ver repositorio de ${title}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            Código
          </a>
        )}
      </div>
    </div>
  </article>
)}

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project-card__img-wrap {
    position: relative;
    height: 180px;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-accent-purple) 10%, var(--color-bg-card));
  }
  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms var(--ease-smooth);
  }
  .project-card:hover .project-card__img { transform: scale(1.04); }
  .project-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, var(--color-bg-card));
  }
  .project-card__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
  }

  .project-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .project-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .project-card__desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project-card__links {
    display: flex;
    gap: 16px;
    margin-top: 4px;
  }
  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-smooth);
  }
  .project-card__link:hover { color: var(--color-accent-green); }

  /* Button wrapper for clickable cards */
  .project-card-btn {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    width: 100%;
    display: block;
    font: inherit;
    color: inherit;
  }
  .project-card-btn:hover .project-card.card,
  .project-card-btn:focus-visible .project-card.card {
    border-color: color-mix(in srgb, var(--color-accent-green) 50%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent-green) 10%, transparent);
  }
</style>
