---
const navLinks = [
  { label: "Experiencia", href: "#experiencia" },
  { label: "Skills",      href: "#skills"      },
  { label: "Educación",   href: "#educacion"   },
  { label: "Contacto",    href: "#contacto"    },
];
---

<header class="navbar" role="banner">
  <div class="container navbar__inner">
    <!-- Logo -->
    <a href="/" class="navbar__logo" aria-label="Inicio">
      <span class="navbar__logo-text">LNF</span><span class="navbar__logo-accent">DEV</span>
    </a>

    <!-- Desktop nav -->
    <nav class="navbar__links" aria-label="Navegación principal">
      {navLinks.map(({ label, href }) => (
        <a href={href} class="navbar__link">{label}</a>
      ))}
      <a href="#contacto" class="btn-primary navbar__cta">Contacto</a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      class="navbar__hamburger"
      id="menu-btn"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="navbar__mobile" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Menú móvil">
    <nav class="navbar__mobile-links">
      {navLinks.map(({ label, href }) => (
        <a href={href} class="navbar__mobile-link">{label}</a>
      ))}
      <a href="#contacto" class="btn-primary" style="text-align:center;">Contacto</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--color-bg-primary) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 200ms var(--ease-smooth);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .navbar__logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .navbar__logo-text { color: var(--color-text-primary); }
  .navbar__logo-accent { color: var(--color-accent-green); }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .navbar__link {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-smooth);
  }
  .navbar__link:hover { color: var(--color-text-primary); }

  .navbar__cta {
    padding: 8px 20px;
    font-size: 0.85rem;
  }

  /* Hamburger */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .navbar__hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background-color: var(--color-text-primary);
    border-radius: 2px;
    transition: transform 250ms var(--ease-smooth), opacity 250ms var(--ease-smooth);
  }
  .navbar__hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .navbar__hamburger.open span:nth-child(2) { opacity: 0; }
  .navbar__hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .navbar__mobile {
    display: none;
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    overflow: hidden;
    max-height: 0;
    transition: max-height 300ms var(--ease-smooth);
  }
  .navbar__mobile.open {
    max-height: 400px;
  }
  .navbar__mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 16px 24px 24px;
  }
  .navbar__mobile-link {
    display: block;
    padding: 14px 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    transition: color 150ms var(--ease-smooth);
  }
  .navbar__mobile-link:last-of-type { margin-bottom: 16px; }
  .navbar__mobile-link:hover { color: var(--color-accent-green); }

  @media (max-width: 768px) {
    .navbar__links { display: none; }
    .navbar__hamburger { display: flex; }
    .navbar__mobile { display: block; }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;

  btn?.addEventListener('click', () => {
    const isOpen = btn.classList.toggle('open');
    menu.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    menu.setAttribute('aria-hidden', String(!isOpen));
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      btn.classList.remove('open');
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
