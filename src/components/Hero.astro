---
---

<section class="hero" aria-label="Presentación principal">
  <!-- Background glow blobs -->
  <div class="hero__blob hero__blob--green" aria-hidden="true"></div>
  <div class="hero__blob hero__blob--purple" aria-hidden="true"></div>

  <div class="container hero__inner">
    <!-- Text content -->
    <div class="hero__content fade-in">
      <p class="hero__available">
        <span class="hero__dot" aria-hidden="true"></span>
        Disponible para nuevos proyectos
      </p>

      <h1 class="hero__name">
        Lucas Nicolás<br />
        <span class="glow-text">Flores</span>
      </h1>

      <p class="hero__title">Desarrollador de Software</p>

      <p class="hero__bio">
        Soy un apasionado desarrollador con enfoque en la eficiencia y la
        innovación. Me especializo en crear soluciones tecnológicas que
        simplifican procesos y mejoran la experiencia del usuario.
      </p>

      <div class="hero__actions">
        <a href="#contacto" class="btn-primary">
          Trabaja conmigo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#experiencia" class="btn-outline">Ver experiencia</a>
      </div>
    </div>

    
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 68px; /* navbar height */
    overflow: hidden;
  }

  /* Background glows */
  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .hero__blob--green {
    width: 500px;
    height: 500px;
    background: color-mix(in srgb, var(--color-accent-green) 8%, transparent);
    top: -100px;
    right: -50px;
  }
  .hero__blob--purple {
    width: 400px;
    height: 400px;
    background: color-mix(in srgb, var(--color-accent-purple) 8%, transparent);
    bottom: -50px;
    left: -100px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 64px;
    align-items: center;
    padding-block: 80px;
  }

  /* Available pill */
  .hero__available {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent-green);
    background: color-mix(in srgb, var(--color-accent-green) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-green) 25%, transparent);
    padding: 6px 14px;
    border-radius: 99px;
    margin-bottom: 24px;
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent-green);
    box-shadow: 0 0 6px var(--color-accent-green);
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Name */
  .hero__name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .hero__title {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 20px;
  }

  .hero__bio {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: 36px;
  }

  .hero__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Photo */
  .hero__photo-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .hero__photo-frame {
    position: absolute;
    inset: -12px;
    border: 2px solid color-mix(in srgb, var(--color-accent-green) 40%, transparent);
    border-radius: 16px;
    pointer-events: none;
  }
  .hero__photo-corner {
    position: absolute;
    width: 20px;
    height: 20px;
    border-color: var(--color-accent-green);
    border-style: solid;
  }
  .hero__photo-corner--tl {
    top: -2px; left: -2px;
    border-width: 3px 0 0 3px;
    border-radius: 4px 0 0 0;
  }
  .hero__photo-corner--br {
    bottom: -2px; right: -2px;
    border-width: 0 3px 3px 0;
    border-radius: 0 0 4px 0;
  }

  .hero__photo-container {
    width: 320px;
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero__photo-placeholder {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    text-align: center;
  }
  .hero__photo-placeholder code {
    color: var(--color-accent-green);
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
    .hero__bio { margin-inline: auto; }
    .hero__actions { justify-content: center; }
    .hero__photo-wrap { order: -1; }
    .hero__photo-container { width: 220px; height: 280px; }
  }

  @media (max-width: 480px) {
    .hero__photo-container { width: 180px; height: 220px; }
  }
</style>
