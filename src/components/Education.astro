---
const education = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    degree: "Licenciatura en Ciberdefensa y Ciberseguridad",
    institution: "UNDEF — Universidad de la Defensa Nacional",
    period: "02/2026 – Presente",
    current: true,
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
    degree: "Técnico Superior en Desarrollo de Software",
    institution: "Instituto Superior Roque González de Santa Cruz",
    period: "01/2025 – Presente",
    current: true,
  },
];

const courses = [
  { name: "React Basics", provider: "Coursera" },
  { name: "Data Science Foundations", provider: "IBM" },
  { name: "Version Control", provider: "Meta" },
  { name: "Web Development", provider: "Coursera" },
  { name: "Intermediate SQL", provider: "Coursera" },
  { name: "Agile / Scrum", provider: "Coursera" },
  { name: "Google Data Analytics", provider: "Google" },
  { name: "Flutter Development", provider: "Udemy" },
  { name: "React Fundamentals", provider: "Meta" },
];

const languages = [
  { name: "Español", level: "Nativo", percent: 100 },
  { name: "Inglés", level: "Conversacional", percent: 70 },
];
---

<section class="section" id="educacion" aria-labelledby="edu-title">
  <div class="container">
    <div class="edu__header fade-in">
      <p class="section-label">Formación</p>
      <h2 class="section-title" id="edu-title">Academic Formation</h2>
    </div>

    <div class="edu__layout">
      <!-- Left: education + courses -->
      <div class="edu__left">
        <!-- Degrees -->
        <div class="edu__degrees fade-in">
          {
            education.map((item) => (
              <div class="edu__degree card">
                <div
                  class="edu__degree-icon"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                <div class="edu__degree-body">
                  <div class="edu__degree-meta">
                    <span class="edu__period">{item.period}</span>
                    {item.current && <span class="tag">Cursando</span>}
                  </div>
                  <h3 class="edu__degree-title">{item.degree}</h3>
                  <p class="edu__degree-inst">{item.institution}</p>
                </div>
              </div>
            ))
          }
        </div>

        {
          /*
        <!-- Courses -->

                  <div class="edu__courses fade-in" style="transition-delay:120ms">
          <p class="edu__courses-label section-label">Certificaciones</p>
          <div class="edu__courses-grid" role="list">
            {
              courses.map((c) => (
                <div class="edu__course card" role="listitem">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    aria-hidden="true"
                    style="color:var(--color-accent-green);flex-shrink:0;margin-top:1px"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <div>
                    <p class="edu__course-name">{c.name}</p>
                    <p class="edu__course-provider">{c.provider}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
          */
        }
      </div>

      <!-- Right: languages -->
      <div class="edu__right fade-in" style="transition-delay:80ms">
        <div class="edu__lang-card card">
          <p class="section-label" style="margin-bottom:20px">Idiomas</p>
          <div class="edu__lang-list" role="list">
            {
              languages.map((lang) => (
                <div class="edu__lang-item" role="listitem">
                  <div class="edu__lang-header">
                    <span class="edu__lang-name">{lang.name}</span>
                    <span class="edu__lang-level">{lang.level}</span>
                  </div>
                  <div
                    class="edu__lang-bar"
                    role="progressbar"
                    aria-valuenow={lang.percent}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-label={`${lang.name}: ${lang.level}`}
                  >
                    <div
                      class="edu__lang-fill"
                      style={`width:${lang.percent}%`}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu__header {
    margin-bottom: 48px;
  }
  .edu__header .section-label {
    margin-bottom: 8px;
  }

  .edu__layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 32px;
    align-items: start;
  }

  /* Degrees */
  .edu__degrees {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }
  .edu__degree {
    display: flex;
    gap: 16px;
    padding: 20px;
    align-items: flex-start;
  }
  .edu__degree-icon {
    color: var(--color-accent-green);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .edu__degree-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  .edu__period {
    font-size: 0.75rem;
    color: var(--color-accent-green);
    font-weight: 500;
  }
  .edu__degree-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .edu__degree-inst {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  /* Courses */
  .edu__courses-label {
    margin-bottom: 16px;
  }
  .edu__courses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .edu__course {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 12px 14px;
  }
  .edu__course-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }
  .edu__course-provider {
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  /* Languages */
  .edu__lang-card {
    padding: 24px;
    position: sticky;
    top: 84px;
  }
  .edu__lang-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .edu__lang-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .edu__lang-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .edu__lang-level {
    font-size: 0.75rem;
    color: var(--color-accent-green);
    font-weight: 500;
  }
  .edu__lang-bar {
    height: 6px;
    background-color: var(--color-border);
    border-radius: 99px;
    overflow: hidden;
  }
  .edu__lang-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-accent-green),
      color-mix(
        in srgb,
        var(--color-accent-green) 60%,
        var(--color-accent-purple)
      )
    );
    border-radius: 99px;
    transition: width 800ms var(--ease-smooth);
  }

  @media (max-width: 900px) {
    .edu__layout {
      grid-template-columns: 1fr;
    }
    .edu__lang-card {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .edu__courses-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
