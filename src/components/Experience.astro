---
const experiences = [
  {
    period: "09/2023 – Presente",
    role: "Asesor y Desarrollador Web",
    company: "Silicon I+D+I",
    companyUrl: undefined,
    type: "Lanzamiento de Producto / Business Canvas",
    description: "Liderazgo técnico en desarrollo web front-end y back-end con enfoque en establecer experiencias de usuario.",
    achievements: [
      "Arquitectura y optimización de soluciones web",
      "Mentoría y liderazgo del equipo técnico",
      "Integración de herramientas de analítica y automatización",
    ],
    tags: ["React", "Astro", "Laravel", "PHP", "MySQL", "Figma"],
    current: true,
  },
  {
    period: "01/2022 – 10/2023",
    role: "Data Analyst & Operations Developer",
    company: "Polo Tic Misiones",
    companyUrl: undefined,
    type: "Power BI Dashboards & Workflow",
    description: "Desarrollo de infraestructura de datos para la toma de decisiones estratégicas y la automatización de procesos operativos.",
    achievements: [
      "Construcción de dashboards de Power BI",
      "Automatización de flujos con Python y SQL",
      "Soporte al área de operaciones con reportes dinámicos",
    ],
    tags: ["Power BI", "Python", "SQL", "Data Studio", "PostgreSQL"],
    current: false,
  },
];
---

<section class="section" id="experiencia" aria-labelledby="exp-title">
  <div class="container">
    <div class="exp__header fade-in">
      <p class="section-label">Trayectoria</p>
      <h2 class="section-title" id="exp-title">Experiencia Profesional</h2>
      <p class="exp__subtitle">
        Más de 3 años desarrollando productos digitales con enfoque en experiencia de usuario y análisis de datos.
      </p>
    </div>

    <div class="exp__timeline" role="list">
      {experiences.map((exp, i) => (
        <article class="exp__item fade-in" style={`transition-delay:${i * 100}ms`} role="listitem">
          <!-- Timeline dot -->
          <div class="exp__dot-col" aria-hidden="true">
            <div class={`exp__dot ${exp.current ? 'exp__dot--active' : ''}`}></div>
            {i < experiences.length - 1 && <div class="exp__line"></div>}
          </div>

          <!-- Content -->
          <div class="exp__content card">
            <div class="exp__meta">
              <span class="exp__period">{exp.period}</span>
              {exp.current && <span class="tag">Actual</span>}
            </div>

            <h3 class="exp__role">{exp.role}</h3>
            <p class="exp__company">{exp.company}</p>
            <p class="exp__type">{exp.type}</p>

            <p class="exp__desc">{exp.description}</p>

            <ul class="exp__achievements" role="list">
              {exp.achievements.map(a => (
                <li class="exp__achievement">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {a}
                </li>
              ))}
            </ul>

            <div class="exp__tags" role="list" aria-label="Tecnologías">
              {exp.tags.map(tag => (
                <span class="tag" role="listitem">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .exp__header {
    max-width: 600px;
    margin-bottom: 56px;
  }
  .exp__header .section-label { margin-bottom: 8px; }
  .exp__header .section-title { margin-bottom: 12px; }
  .exp__subtitle {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }

  .exp__timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .exp__item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 24px;
    position: relative;
  }

  /* Timeline track */
  .exp__dot-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 28px;
  }
  .exp__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    background-color: var(--color-bg-secondary);
    flex-shrink: 0;
    z-index: 1;
    transition: border-color 200ms;
  }
  .exp__dot--active {
    border-color: var(--color-accent-green);
    background-color: var(--color-accent-green);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent-green) 50%, transparent);
  }
  .exp__line {
    width: 2px;
    flex: 1;
    min-height: 32px;
    background: linear-gradient(to bottom, var(--color-accent-green), var(--color-border));
    margin-top: 6px;
  }

  /* Card */
  .exp__content {
    padding: 28px;
    margin-bottom: 24px;
  }

  .exp__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .exp__period {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent-green);
    letter-spacing: 0.02em;
  }

  .exp__role {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .exp__company {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 2px;
  }
  .exp__type {
    font-size: 0.8rem;
    color: var(--color-accent-purple);
    opacity: 0.8;
    margin-bottom: 14px;
  }
  .exp__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .exp__achievements {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 18px;
  }
  .exp__achievement {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .exp__achievement svg {
    color: var(--color-accent-green);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .exp__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .exp__item { grid-template-columns: 1fr; }
    .exp__dot-col { display: none; }
    .exp__content { margin-bottom: 16px; }
  }
</style>
