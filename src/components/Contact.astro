---
---

<section class="section" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__inner">
      <!-- Left: text -->
      <div class="contact__text fade-in">
        <p class="section-label">Colaboración</p>
        <h2 class="contact__title" id="contact-title">
          Ready to<br />
          <span class="glow-text">Collaborate?</span>
        </h2>
        <p class="contact__desc">
          ¿Tenés en mente un sitio web, una pipeline de datos o una arquitectura
          de software? Construyamos algo excepcional juntos.
        </p>

        <div class="contact__info">
          <a href="mailto:lucasnicolasflores@gmail.com" class="contact__info-item" aria-label="Enviar email">
            <span class="contact__info-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </span>
            <span>lucasnicolasflores@gmail.com</span>
          </a>

          <div class="contact__info-item">
            <span class="contact__info-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <span>Posadas, Misiones, Argentina — Remoto</span>
          </div>

          <a
            href="https://www.linkedin.com/in/lucas-nicolas-flores-software-developer/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact__info-item"
            aria-label="Perfil de LinkedIn"
          >
            <span class="contact__info-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
              </svg>
            </span>
            <span>linkedin.com/in/lucas-nicolas-flores</span>
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <div class="contact__form-wrap fade-in" style="transition-delay:100ms">
        <form class="contact__form card" novalidate aria-label="Formulario de contacto">
          <div class="contact__field">
            <label for="contact-name" class="contact__label">Nombre completo</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              class="contact__input"
              placeholder="Tu nombre"
              autocomplete="name"
              required
              minlength="2"
            />
          </div>

          <div class="contact__field">
            <label for="contact-email" class="contact__label">Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              class="contact__input"
              placeholder="tu@email.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="contact__field">
            <label for="contact-message" class="contact__label">Detalles del proyecto</label>
            <textarea
              id="contact-message"
              name="message"
              class="contact__input contact__textarea"
              placeholder="Contame sobre tu proyecto..."
              rows="5"
              required
              minlength="10"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary contact__submit" aria-label="Enviar mensaje">
            Enviar mensaje
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 2 11 13M22 2 15 22l-4-9-9-4 20-7z"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .contact__text .section-label { margin-bottom: 12px; }

  .contact__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .contact__desc {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 440px;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact__info-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-smooth);
  }
  a.contact__info-item:hover { color: var(--color-accent-green); }
  .contact__info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: color-mix(in srgb, var(--color-accent-green) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-green) 20%, transparent);
    color: var(--color-accent-green);
    flex-shrink: 0;
  }

  /* Form */
  .contact__form {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact__label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }
  .contact__input {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: 0.9rem;
    padding: 12px 16px;
    transition: border-color 150ms var(--ease-smooth), box-shadow 150ms var(--ease-smooth);
    outline: none;
    width: 100%;
  }
  .contact__input::placeholder { color: var(--color-text-secondary); opacity: 0.5; }
  .contact__input:focus {
    border-color: var(--color-accent-green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-green) 15%, transparent);
  }
  .contact__input:invalid:not(:placeholder-shown) {
    border-color: color-mix(in srgb, #ff4444 60%, transparent);
  }
  .contact__textarea { resize: vertical; min-height: 120px; }

  .contact__submit { width: 100%; justify-content: center; padding: 14px; }

  @media (max-width: 900px) {
    .contact__inner { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
