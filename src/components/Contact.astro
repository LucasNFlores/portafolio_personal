---
const EMAIL = "lucasnicolasflores@gmail.com";
---

<section class="section" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__inner">
      <div class="contact__text fade-in">
        <p class="section-label">Colaboración</p>
        <h2 class="contact__title" id="contact-title">
          Ready to<br />
          <span class="glow-text">Collaborate?</span>
        </h2>
        <p class="contact__desc">
          ¿Tenés en mente un sitio web, una pipeline de datos o una arquitectura
          de software? Construyamos algo excepcional juntos.
        </p>

        <div class="contact__buttons">
          <a
            href="https://www.linkedin.com/in/lucas-nicolas-flores-software-developer/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact__btn"
            aria-label="Perfil de LinkedIn"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path><rect x="2" y="9" width="4" height="12"></rect><circle
                cx="4"
                cy="4"
                r="2"></circle>
            </svg>
            LinkedIn
          </a>

          <a
            href="https://github.com/LucasNFlores/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact__btn"
            aria-label="Perfil de GitHub"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 2.998 1.108.871-.241 1.808-.362 2.748-.366.94.004 1.877.125 2.748.366 1.99-1.43 2.994-1.108 2.994-1.108.652 1.652.241 2.873.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              />
            </svg>
            GitHub
          </a>

          <button
            type="button"
            class="contact__btn contact__btn-copy"
            aria-label="Copiar email al portapapeles"
            data-email={EMAIL}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect><path
                d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span class="contact__btn-text">Email</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .contact__text {
    text-align: center;
    max-width: 640px;
    padding: 48px;
    border-radius: var(--radius-card);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }

  .contact__text .section-label {
    margin-bottom: 16px;
  }

  .contact__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .contact__desc {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .contact__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .contact__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    border-radius: var(--radius-btn);
    background-color: var(--color-accent-green);
    color: var(--color-bg-primary);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition:
      opacity 150ms var(--ease-smooth),
      box-shadow 150ms var(--ease-smooth),
      background-color 150ms var(--ease-smooth),
      border-color 150ms var(--ease-smooth);
  }

  .contact__btn:hover {
    opacity: 0.9;
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent-green) 25%, transparent);
  }

  .contact__btn:active {
    transform: translateY(0);
  }

  .contact__btn-text {
    transition: opacity 150ms var(--ease-smooth);
    min-width: 40px;
    display: inline-block;
    text-align: center;
  }

  .contact__btn-copy.copied {
    background-color: var(--color-bg-card);
    color: var(--color-accent-green);
    border: 1px solid var(--color-accent-green);
  }

  @media (max-width: 600px) {
    .contact__text {
      padding: 32px 24px;
    }

    .contact__buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .contact__btn {
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.querySelector('.contact__btn-copy');
    if (copyBtn) {
      const textEl = copyBtn.querySelector('.contact__btn-text');
      const original = textEl.textContent.trim();
      
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.dataset.email;
        await navigator.clipboard.writeText(email);
        textEl.style.opacity = '0';
        setTimeout(() => {
          textEl.textContent = '¡Copiado!';
          textEl.style.opacity = '1';
          copyBtn.classList.add('copied');
        }, 150);
        setTimeout(() => {
          textEl.style.opacity = '0';
          setTimeout(() => {
            textEl.textContent = original;
            textEl.style.opacity = '1';
            copyBtn.classList.remove('copied');
          }, 150);
        }, 2000);
      });
    }
  });
</script>
