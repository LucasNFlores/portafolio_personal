---
const year = new Date().getFullYear();
const socials = [
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/lucas-nicolas-flores-software-developer/",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    name: "GitHub",
    href: "https://github.com/",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Inicio">
        <span>LNF</span><span style="color:var(--color-accent-green)">DEV</span>
      </a>
      <p class="footer__tagline">Desarrollador de Software · Posadas, Argentina</p>
    </div>

    <p class="footer__copy">
      &copy; {year} Lucas Nicolás Flores. Todos los derechos reservados.
    </p>

    <div class="footer__socials" role="list" aria-label="Redes sociales">
      {socials.map(s => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social"
          aria-label={s.name}
          role="listitem"
          set:html={s.icon}
        />
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
    padding-block: 32px;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer__brand { display: flex; flex-direction: column; gap: 4px; }
  .footer__logo {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }
  .footer__tagline {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .footer__copy {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .footer__socials {
    display: flex;
    gap: 12px;
  }
  .footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    transition: color 150ms var(--ease-smooth), border-color 150ms var(--ease-smooth);
  }
  .footer__social:hover {
    color: var(--color-accent-green);
    border-color: var(--color-accent-green);
  }

  @media (max-width: 640px) {
    .footer__inner { justify-content: center; text-align: center; }
    .footer__socials { justify-content: center; }
  }
</style>
